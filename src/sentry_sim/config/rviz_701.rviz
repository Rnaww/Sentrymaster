Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 35; 40; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: 地面参考网格
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 85; 95; 110
    Reference Frame: map
    Alpha: 0.3
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: 仿真哨兵机器人
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    TF Prefix: ''
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/Odometry
    Name: 仿真里程计
    Enabled: true
    Topic:
      Value: /navigation_odom
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
    Keep: 50
    Position Tolerance: 0.1
    Angle Tolerance: 0.15
    Shape:
      Value: Arrow
      Color: 255; 200; 70
      Alpha: 1
      Shaft Length: 0.4
      Shaft Radius: 0.03
      Head Length: 0.15
      Head Radius: 0.07
    Covariance:
      Value: false
    Value: true
  - Class: rviz_default_plugins/TF
    Name: 坐标系（可选）
    Enabled: false
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Marker Scale: 0.3
    Value: false
  - Class: rviz_default_plugins/Marker
    Name: 701 场地模型
    Enabled: true
    Topic:
      Value: /simulation_field
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Value: true
  - Class: rviz_default_plugins/Path
    Name: 当前规划路径
    Enabled: true
    Topic:
      Value: /planned_path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Line Style: Lines
    Line Width: 0.04
    Color: 90; 210; 255
    Alpha: 1
    Buffer Length: 1
    Value: true
  - Class: rviz_default_plugins/Path
    Name: 实际行驶轨迹
    Enabled: true
    Topic:
      Value: /executed_path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Line Style: Lines
    Line Width: 0.04
    Color: 255; 170; 60
    Alpha: 1
    Buffer Length: 1
    Value: true
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 23
      Focal Point:
        X: 9
        Y: 7
        Z: 0.5
      Pitch: 1.05
      Yaw: 0.8
Window Geometry:
  Width: 1440
  Height: 900
