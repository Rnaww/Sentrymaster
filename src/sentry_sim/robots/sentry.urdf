<?xml version="1.0"?>
<robot name="sentry_simulator">
  <!--
    Reference model copied from sentry-chassis-2026. Chassis dimensions follow PolarBear's
    rm25_example_robot (used by pb2025_sentry_nav): 75.8 mm radius,
    45.2 mm width, 0.4 kg wheel mass, and low-friction wheel contact.
    Gazebo Ionic uses sentry_gazebo for the planar command interface;
    collision geometry and visual assets are retained.
  -->
  <link name="sim_chassis_link">
    <!--
      Offline visual assets copied from PolarBear's rm25_example_robot
      (rmoss_gz_resources at b5c759f).  The collision geometry below remains
      the existing chassis body.
    -->
    <visual name="reference_chassis_visual">
      <origin xyz="0 0 -0.2242" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/chassis_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="1.6066666666666667" ixy="0" ixz="0" iyy="1.6066666666666667" iyz="0" izz="3.0"/>
    </inertial>
  </link>

  <link name="gimbal_yaw_link">
    <visual name="reference_gimbal_yaw_visual">
      <origin xyz="0 0 -0.0866" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/gimbal_yaw.dae"/>
      </geometry>
    </visual>
    <visual name="reference_gimbal_pitch_visual">
      <origin xyz="0 0 0.0734" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/gimbal_pitch.dae"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="gimbal_yaw_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="gimbal_yaw_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1.0" friction="0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_left.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.2242 0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_right.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.2242 -0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_right.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.2242 0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_left.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.2242 -0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="gimbal_yaw_link">
    <gravity>false</gravity>
  </gazebo>

  <gazebo>
    <plugin filename="libSentryPlanarMove.so" name="sentry_gazebo::PlanarMove">
      <topic>/sentry_robot/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>sim_chassis_link</robot_base_frame>
      <odom_topic>/sentry_robot/odom</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/sentry_robot/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
