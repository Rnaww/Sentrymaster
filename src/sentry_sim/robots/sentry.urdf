<?xml version="1.0"?>
<robot name="sentry_simulator">
  <!--
    Reference model copied from sentry-chassis-2026. Chassis dimensions follow PolarBear's
    rm25_example_robot (used by pb2025_sentry_nav): 75.8 mm radius,
    45.2 mm width, 0.4 kg wheel mass, and low-friction wheel contact.
    Gazebo Classic retains its planar-move plugin so the existing ROS API
    remains unchanged.
  -->
  <link name="sim_chassis_link">
    <!--
      Offline visual assets copied from PolarBear's rm25_example_robot
      (rmoss_gz_resources at b5c759f).  The collision geometry below remains
      the existing stable Classic-Gazebo chassis body.
    -->
    <visual name="reference_chassis_visual">
      <origin xyz="0 0 -0.2242" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/chassis_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="1.6066666666666667" ixy="0" ixz="0" iyy="1.6066666666666667" iyz="0" izz="3.0"/>
    </inertial>
  </link>

  <link name="gimbal_yaw_link">
    <visual name="reference_gimbal_yaw_visual">
      <origin xyz="0 0 -0.0866" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/gimbal_yaw.dae"/>
      </geometry>
    </visual>
    <visual name="reference_gimbal_pitch_visual">
      <origin xyz="0 0 0.0734" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/gimbal_pitch.dae"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="gimbal_yaw_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="gimbal_yaw_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1.0" friction="0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_left.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.2242 0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_right.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.2242 -0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_right.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.2242 0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="model://sentry_robot_visual/meshes/wheel_left.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.0758" length="0.0452"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006426653333333334" ixy="0" ixz="0" iyy="0.0006426653333333334" iyz="0" izz="0.0011491280000000001"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.2242 -0.2774 -0.2242" rpy="0 0 0"/>
    <parent link="sim_chassis_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="gimbal_yaw_link">
    <gravity>false</gravity>
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="sentry_gimbal_state">
      <ros>
        <namespace>/sentry_robot</namespace>
        <remapping>joint_states:=/joint_states</remapping>
      </ros>
      <update_rate>150</update_rate>
      <joint_name>gimbal_yaw_joint</joint_name>
      <!-- Publish every movable joint so RViz can locate all four wheel links. -->
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
    <plugin filename="libgazebo_ros_planar_move.so" name="sentry_planar_move">
      <ros>
        <namespace>/sentry_robot</namespace>
      </ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>vehicle</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_tf>false</publish_tf>
      <update_rate>150</update_rate>
      <publish_rate>150</publish_rate>
    </plugin>
  </gazebo>
</robot>
