<?xml version="1.0"?>
<robot name="sentry_simulator">
  <link name="vehicle">
    <visual><geometry><box size="0.6 0.6 0.6"/></geometry></visual>
    <collision><geometry><box size="0.6 0.6 0.6"/></geometry></collision>
    <inertial>
      <mass value="25.6"/>
      <inertia ixx="1.536" ixy="0" ixz="0" iyy="1.536" iyz="0" izz="1.536"/>
    </inertial>
  </link>
  <gazebo reference="vehicle"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/sentry_robot</namespace><remapping>odom:=odom</remapping><remapping>cmd_vel:=cmd_vel</remapping></ros>
      <update_rate>100.0</update_rate>
      <publish_rate>50.0</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>vehicle</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
